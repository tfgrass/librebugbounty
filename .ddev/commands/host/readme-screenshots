#!/bin/sh
## Description: Capture README images from a disposable English demo database
## Usage: readme-screenshots
## Example: "ddev readme-screenshots"
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
PROJECT_NAME=${DDEV_SITENAME:-$(awk '/^name:/ { print $2; exit }' "$ROOT_DIR/.ddev/config.yaml")}
case "$PROJECT_NAME" in
  ''|*[!a-zA-Z0-9_-]*)
    echo "Could not determine a safe DDEV project name." >&2
    exit 1
    ;;
esac

WEB_CONTAINER="ddev-${PROJECT_NAME}-web"
PLAYWRIGHT_CONTAINER="ddev-${PROJECT_NAME}-playwright"
if ! docker inspect "$WEB_CONTAINER" "$PLAYWRIGHT_CONTAINER" >/dev/null 2>&1; then
  echo "The DDEV web and Playwright containers must be running. Run: ddev start" >&2
  exit 1
fi

DEMO_ID="$(date +%s)-$$"
DEMO_ROOT="/tmp/librebugbounty-readme-demo-${DEMO_ID}"
PORT=${README_DEMO_PORT:-$((18000 + ($$ % 10000)))}
case "$PORT" in
  ''|*[!0-9]*)
    echo "README_DEMO_PORT must be a numeric container port." >&2
    exit 1
    ;;
esac
if [ "$PORT" -lt 1024 ] || [ "$PORT" -gt 65535 ]; then
  echo "README_DEMO_PORT must be between 1024 and 65535." >&2
  exit 1
fi

BASE_URL="http://web:${PORT}"
TEMP_OUTPUT="/var/www/html/var/readme-screenshots-${DEMO_ID}"
FINAL_OUTPUT="/var/www/html/docs/screenshots"
HOST_UID=$(id -u)
HOST_GID=$(id -g)

cleanup() {
  docker exec "$WEB_CONTAINER" sh -c '
    test -f "$1/server.pid" || exit 0
    server_pid=$(cat "$1/server.pid")
    case "$server_pid" in ""|*[!0-9]*) exit 0 ;; esac
    test -r "/proc/$server_pid/cmdline" || exit 0
    command_line=$(tr "\000" " " <"/proc/$server_pid/cmdline")
    case "$command_line" in
      *"0.0.0.0:$2"*"tests/Support/readme_demo_router.php"*) kill "$server_pid" || true ;;
    esac
  ' sh "$DEMO_ROOT" "$PORT" >/dev/null 2>&1 || true
  docker exec -u root "$WEB_CONTAINER" rm -rf "$DEMO_ROOT" "$TEMP_OUTPUT" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

printf 'Creating a disposable English demo database ...\n'
docker exec -w /var/www/html -e README_DEMO_ROOT="$DEMO_ROOT" "$WEB_CONTAINER" \
  php tests/Support/readme_demo_router.php init

docker exec -d -w /var/www/html "$WEB_CONTAINER" sh -c \
  'echo $$ > "$1/server.pid"; exec env README_DEMO_ROOT="$1" php -S "0.0.0.0:$2" -t public tests/Support/readme_demo_router.php >"$1/server.log" 2>&1' \
  sh "$DEMO_ROOT" "$PORT"

ready=0
attempt=0
while [ "$attempt" -lt 50 ]; do
  if docker exec "$PLAYWRIGHT_CONTAINER" node -e \
    'fetch(process.argv[1]).then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))' \
    "$BASE_URL/__readme_demo_fixture" >/dev/null 2>&1; then
    ready=1
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.2
done
if [ "$ready" -ne 1 ]; then
  echo "The disposable README demo server did not become ready." >&2
  docker exec "$WEB_CONTAINER" cat "$DEMO_ROOT/server.log" >&2 || true
  exit 1
fi

printf 'Capturing four Studio views from isolated fixtures ...\n'
docker exec -w /var/www/html \
  -e README_DEMO_BASE="$BASE_URL" \
  -e README_SCREENSHOT_OUTPUT="$TEMP_OUTPUT" \
  "$PLAYWRIGHT_CONTAINER" node tests/browser/readme-screenshots.cjs

docker exec -u root "$WEB_CONTAINER" sh -c '
  set -eu
  source_dir=$1
  target_dir=$2
  mkdir -p "$target_dir"
  rm -f \
    "$target_dir/overview-redacted.png" \
    "$target_dir/detail-redacted.png" \
    "$target_dir/review.png" \
    "$target_dir/inventory.png" \
    "$target_dir/finding-detail.png" \
    "$target_dir/statistics.png"
  for image in review.png inventory.png finding-detail.png statistics.png; do
    test -s "$source_dir/$image"
    cp "$source_dir/$image" "$target_dir/$image"
  done
  chown "$3:$4" "$target_dir" \
    "$target_dir/review.png" \
    "$target_dir/inventory.png" \
    "$target_dir/finding-detail.png" \
    "$target_dir/statistics.png"
' sh "$TEMP_OUTPUT" "$FINAL_OUTPUT" "$HOST_UID" "$HOST_GID"

echo "Wrote docs/screenshots/{review,inventory,finding-detail,statistics}.png"
